# ============================================================
# TURFEX — .gitignore
# ============================================================

# ---- Node / Next.js (frontend) ----
node_modules/
.next/
out/
build/
dist/
.npm/
*.tsbuildinfo
next-env.d.ts

# ---- Variables d'environnement (secrets) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ---- Python / FastAPI (backend) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
pip-wheel-metadata/
*.egg-info/
.eggs/
*.egg

# ---- Base de données SQLite (données locales) ----
*.db
*.sqlite
*.sqlite3

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Coverage / tests ----
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.coverage

# ---- Misc ----
.cache/
.parcel-cache/
*.pid
*.seed
*.pid.lock
